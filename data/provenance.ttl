    prov:used ric:inst-jsk-full, ric:selector-e314c0ab4ecc, ric:selector-quote-8766adfc241b.
ric:selector-quote-8766adfc241b a oa:TextQuoteSelector;
    oa:exact "그때 우리 헌법 선생님이 한동섭韓東燮이라는 분이셨는데, 그분이 쓴 헌법 책도 있었어요.".
ric:activity-8c5c7955d422 prov:wasAssociatedWith ric:agent-claude-code__claude-fable-5_;
