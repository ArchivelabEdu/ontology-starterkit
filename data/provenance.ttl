ric:activity-09d2231286f5 a prov:Activity;
    prov:used ric:inst-jsk-full, ric:selector-94e1418c8ec8, ric:selector-quote-9cf53b48dea7.
ric:selector-quote-9cf53b48dea7 a oa:TextQuoteSelector;
    oa:exact "그래서 제가 다시 통합하는 것이 옳다는 판단을 하고 노무현 대통령을 설득해서 통합을 하게 되지요.".
ric:activity-09d2231286f5 prov:wasAssociatedWith ric:agent-claude-code__claude-fable-5_;
    prov:generatedAtTime "2026-08-15T22:13:35+09:00"^^xsd:dateTime.
