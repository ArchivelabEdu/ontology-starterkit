ric:activity-6347487b8c70 a prov:Activity;
    prov:used ric:inst-jsk-full, ric:selector-5fb21d6d4d3f, ric:selector-quote-396cd541890b.
ric:selector-quote-396cd541890b a oa:TextQuoteSelector;
    oa:exact "선후배나 동료 중에는 전에 법무부 차관을 한 정진호鄭振昊라는 친구가 있고, 행시나 사시에 합격했던 친구들이 있고요.".
ric:activity-6347487b8c70 prov:wasAssociatedWith ric:agent-claude-code__claude-fable-5_;
    prov:generatedAtTime "2026-08-15T22:13:35+09:00"^^xsd:dateTime.
